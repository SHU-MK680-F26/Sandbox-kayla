# OPTIONAL — Week 4 or later. Rename to claude.yml to activate.
#
# Lets anyone with write access summon @claude on a pull request or issue for an automated
# brand-and-compliance review BEFORE the human review. Requires:
#   1. The Claude GitHub App installed on this repository (instructor does this at the org level).
#   2. A secret named ANTHROPIC_API_KEY (Console key) or CLAUDE_CODE_OAUTH_TOKEN (from `claude setup-token`)
#      available to this repository. Never commit a token to the repo.
# Each run consumes GitHub Actions minutes (2,000/month shared across private repos on Free; 3,000 on Team)
# plus Claude tokens. The `if:` guard stops the runner from starting on ordinary comments.
#
# Reference: https://code.claude.com/docs/en/github-actions

name: Claude review
on:
  issue_comment:
    types: [created]
  pull_request_review_comment:
    types: [created]
  issues:
    types: [opened, assigned]
  pull_request_review:
    types: [submitted]

jobs:
  claude:
    if: contains(github.event.comment.body, '@claude') || contains(github.event.issue.body, '@claude') || contains(github.event.review.body, '@claude')
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: write
      pull-requests: write
      issues: write
      id-token: write
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 1
      - uses: anthropics/claude-code-action@v1
        with:
          anthropic_api_key: ${{ secrets.ANTHROPIC_API_KEY }}
          # or: claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
          claude_args: "--max-turns 15"
